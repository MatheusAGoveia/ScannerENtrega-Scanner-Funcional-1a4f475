POSTGRES_DB=govsec_scanner
POSTGRES_USER=govsec_scanner
POSTGRES_PASSWORD=troque-esta-senha-do-banco
SCANNER_ENVIRONMENT=production
SCANNER_ALLOW_PUBLIC_TARGETS=false
SCANNER_MAX_ADDRESSES_PER_RANGE=4096

# Zabbix e opcional. Sem estes valores, o scanner registra a integracao como nao configurada.
SCANNER_ZABBIX_URL=
SCANNER_ZABBIX_TOKEN=

# Configuracao do Frontend e Proxy (Segredos de Servidor)
BACKEND_URL=http://localhost:8000
SESSION_SECRET=troque-este-segredo-de-sessao-com-pelo-menos-32-caracteres
SCANNER_AUTH_USER=admin-govsec
SCANNER_AUTH_PASS=troque-esta-senha-de-usuario-admin
SCANNER_API_KEY=troque-esta-chave-com-pelo-menos-32-caracteres
